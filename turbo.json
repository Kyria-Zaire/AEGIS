{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.base.js"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "env": ["DATABASE_URL", "ANTHROPIC_API_KEY"],
      "outputs": [".next/**", "!.next/cache/**", "bin/**"]
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
