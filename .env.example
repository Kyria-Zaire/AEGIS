# Copy to .env (root) — values below match infra/docker/docker-compose.yml. Local dev only.
AEGIS_POSTGRES_PORT=5440
AEGIS_REDIS_PORT=6380
DATABASE_URL=postgresql://aegis:aegis@localhost:5440/aegis
REDIS_URL=redis://localhost:6380/0

# Auth.js + GitHub OAuth App
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App (the PEM path should point to apps/web/.secrets/... in local development)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Anthropic — leave empty to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=

# Worker
WORKER_HTTP_ADDR=:8090
WORKER_CONCURRENCY=10
LOG_LEVEL=info
