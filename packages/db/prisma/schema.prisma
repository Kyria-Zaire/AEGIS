// Connection URL lives in prisma.config.ts (Prisma 7).
//
// Conventions:
// - Tables and columns are snake_case (@@map/@map): the Go worker queries them with raw SQL via pgx.
// - IDs are UUIDs generated by Postgres (gen_random_uuid()) so Prisma and the Go worker insert the same way.
// - `updated_at` has a DB default, but Prisma's @updatedAt is client-side: raw SQL writers must set it on UPDATE.
// - Multi-tenancy: every tenant-owned row carries organization_id. Child rows reference their parent through a
//   composite FK (parent_id, organization_id) so a row can never point at another tenant's data.
// - Soft delete (deleted_at) on Organization and Repository only. Hard deletes cascade from the owning tenant.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js v5 (Prisma adapter) ────────────────────────────────────────────────────────────────────────────

/// OAuth-only (GitHub) for now: no password hash.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  personalWorkspace Organization? @relation("PersonalWorkspace")
  triggeredScans    Scan[]
  createdApiKeys    ApiKey[]

  @@map("users")
}

/// Field names follow the OAuth spec as required by @auth/prisma-adapter.
/// TODO(debt): access_token / refresh_token / id_token are persisted in clear by the stock adapter. Aegis reads
/// repositories through the GitHub App (installation tokens), not user tokens: the auth wiring must wrap
/// adapter.linkAccount to drop (or encrypt) them before insert.
model Account {
  userId                   String   @map("user_id") @db.Uuid
  type                     String
  provider                 String
  providerAccountId        String   @map("provider_account_id")
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  /// Returned by GitHub when expiring user tokens are enabled; the adapter crashes if the column is missing.
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────────────────────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

model Organization {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String    @unique
  /// Set only for the auto-created "Personal Workspace": at most one per user.
  personalOwnerId String?   @unique @map("personal_owner_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  personalOwner       User?                @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  githubInstallations GithubInstallation[]
  repositories        Repository[]
  scans               Scan[]
  findings            Finding[]
  apiKeys             ApiKey[]

  @@index([deletedAt])
  @@map("organizations")
}

model Membership {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// ─── GitHub ─────────────────────────────────────────────────────────────────────────────────────────────────

enum GithubAccountType {
  USER
  ORGANIZATION

  @@map("github_account_type")
}

/// A GitHub App installation. Access tokens are minted on demand from the App private key: nothing secret here.
model GithubInstallation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  installationId BigInt            @unique @map("installation_id")
  accountId      BigInt            @map("account_id")
  accountLogin   String            @map("account_login")
  accountType    GithubAccountType @map("account_type")
  suspendedAt    DateTime?         @map("suspended_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositories Repository[]

  @@index([organizationId])
  @@map("github_installations")
}

model Repository {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  /// Nulled when the App is uninstalled: scan history is kept.
  githubInstallationId String?   @map("github_installation_id") @db.Uuid
  githubRepoId         BigInt    @map("github_repo_id")
  fullName             String    @map("full_name")
  defaultBranch        String    @default("main") @map("default_branch")
  isPrivate            Boolean   @default(true) @map("is_private")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubInstallation GithubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  scans              Scan[]
  findings           Finding[]

  /// Re-adding a soft-deleted repo restores the row (clear deleted_at) instead of inserting a duplicate.
  @@unique([organizationId, githubRepoId])
  /// Target of tenant-scoped composite FKs.
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([githubInstallationId])
  @@map("repositories")
}

// ─── Scanning ───────────────────────────────────────────────────────────────────────────────────────────────

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED

  @@map("scan_status")
}

enum ScanTrigger {
  MANUAL
  PUSH
  PULL_REQUEST
  SCHEDULED
  API

  @@map("scan_trigger")
}

model Scan {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  repositoryId   String      @map("repository_id") @db.Uuid
  status         ScanStatus  @default(QUEUED)
  trigger        ScanTrigger
  commitSha      String      @map("commit_sha") @db.VarChar(40)
  branch         String?
  /// Null for automated triggers (push, schedule, API) or once the user is deleted.
  triggeredById  String?     @map("triggered_by_id") @db.Uuid
  startedAt      DateTime?   @map("started_at")
  finishedAt     DateTime?   @map("finished_at")
  /// Operator-facing failure reason. Must never contain source code or secrets.
  errorMessage   String?     @map("error_message")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  triggeredBy  User?        @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  findings     Finding[]

  @@unique([id, repositoryId, organizationId])
  @@index([repositoryId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("scans")
}

/// Values match SEVERITIES in @aegis/core exactly (asserted by an integration test).
enum Severity {
  info
  low
  medium
  high
  critical

  @@map("severity")
}

/// No code snippet column on purpose: findings from a security scanner can quote live secrets.
model Finding {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  repositoryId   String   @map("repository_id") @db.Uuid
  scanId         String   @map("scan_id") @db.Uuid
  ruleId         String   @map("rule_id")
  severity       Severity
  title          String
  message        String
  filePath       String   @map("file_path")
  startLine      Int      @map("start_line")
  endLine        Int?     @map("end_line")
  /// Stable hash of (rule, location, normalized context) used to track a finding across scans.
  fingerprint    String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  scan         Scan         @relation(fields: [scanId, repositoryId, organizationId], references: [id, repositoryId, organizationId], onDelete: Cascade)

  @@unique([scanId, fingerprint])
  @@index([repositoryId, fingerprint])
  @@index([scanId, severity])
  @@index([organizationId, severity])
  @@map("findings")
}

// ─── API access ─────────────────────────────────────────────────────────────────────────────────────────────

/// Only a SHA-256 hash of the key is stored; the plaintext is shown once at creation and never persisted.
model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyHash        String    @unique @map("key_hash")
  /// First 8 chars of the random part, to identify the key in the UI.
  keyPrefix      String    @map("key_prefix") @db.VarChar(8)
  /// Kept after the creator is deleted: the key belongs to the organization.
  createdById    String?   @map("created_by_id") @db.Uuid
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("api_keys")
}
